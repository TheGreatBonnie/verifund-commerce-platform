# Clerk (console auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Live LLM mode. Automated tests force scripted mode.
MARKETMESH_LLM_MODE=live
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.eu-north1.nebius.com/v1/
NEBIUS_MODEL=MiniMaxAI/MiniMax-M3

# Service ports
CONSOLE_PORT=3000
ORCHESTRATOR_PORT=9000
BUYER_PORT=9100
REGISTRY_PORT=9105

# Service URLs
REGISTRY_URL=http://127.0.0.1:9105
ORCHESTRATOR_URL=http://127.0.0.1:9000
ORCHESTRATOR_AGUI_URL=http://127.0.0.1:9000
BUYER_A2A_URL=http://127.0.0.1:9100
BUYER_AGUI_URL=http://127.0.0.1:9100/agui
BUYER_API_URL=http://127.0.0.1:9100
# Shared seller A2A host (one process serves all sellers).
SELLER_SHARED_PORT=9200
SELLER_SHARED_URL=http://127.0.0.1:9200
SELLER_SHARED_DB_URL=sqlite+aiosqlite:///./data/sellers.db
SELLER_INTERNAL_TOKEN=dev-seller-internal
SELLER_CHECKPOINT_PATH=./data/seller-checkpoints.sqlite

# Registry admin
REGISTRY_ADMIN_TOKEN=dev-registry-admin

# A2A bearer tokens are minted on demand by the Verifund control plane
# (POST /v1/internal/buyer-token, /v1/internal/agent-token) and are not
# configured via env. Do not add BUYER_AGENT_TOKEN / SELLER_*_TOKEN.
BUYER_CONSOLE_API_TOKEN=dev-console

# Local bind address and card-fetch allowlist (Compose overrides HOST to 0.0.0.0).
# Exact card URLs allowed for this local demo stack; production should use
# platform-issued /{seller_id}/a2a paths or a registered-endpoint allowlist.
HOST=127.0.0.1
ALLOWED_CARD_HOSTS='["127.0.0.1","localhost","northwind","circuitforge","aurora","summit-tech"]'
ALLOWED_CARD_URLS='["http://127.0.0.1:9200/northwind-audio/.well-known/agent-card.json","http://127.0.0.1:9200/circuitforge/.well-known/agent-card.json","http://127.0.0.1:9200/aurora-supply/.well-known/agent-card.json","http://127.0.0.1:9200/summit-tech/.well-known/agent-card.json"]'

# SQLite
BUYER_DATABASE_URL=sqlite+aiosqlite:///./data/buyer.db
BUYER_CHECKPOINT_PATH=./data/buyer-checkpoints.db
REGISTRY_DATABASE_URL=sqlite+aiosqlite:///./data/registry.db

# ---------------------------------------------------------------------------
# Verifund settlement
# ---------------------------------------------------------------------------
# off preserves the existing MarketMesh flow; fake uses local PayPal; sandbox
# uses the real PayPal Sandbox API. Replace development secrets before sandbox.
VERIFUND_MODE=sandbox
VERIFUND_TENANCY_ENABLED=true
VERIFUND_PORT=9300
VERIFUND_AGENT_PORT=9301
VERIFUND_AGENT_URL=http://127.0.0.1:9301
VERIFUND_AGENT_CARD_URL=http://127.0.0.1:9301/.well-known/agent-card.json
VERIFUND_AGENT_A2A_TOKEN=dev-verifund-agent-a2a
VERIFUND_AGENT_INTERNAL_TOKEN=dev-verifund-agent-internal
VERIFUND_AGENT_TIMEOUT_SECONDS=20
VERIFUND_AGENT_REGISTER_TIMEOUT_SECONDS=60
# Persist both task records and graph checkpoints across restarts.
VERIFUND_AGENT_DATABASE_URL=sqlite+aiosqlite:///./data/verifund-agent.db
VERIFUND_AGENT_CHECKPOINT_PATH=./data/verifund-agent-checkpoints.db
VERIFUND_CONTROL_PLANE_URL=http://127.0.0.1:9300
VERIFUND_PUBLIC_BASE_URL=http://127.0.0.1:9300
VERIFUND_CONSOLE_BASE_URL=http://127.0.0.1:3000
VERIFUND_ALLOW_PUBLIC_BIND=0

# Auth and signing. Use generated secrets before Sandbox use.
VERIFUND_OPS_TOKEN=dev-verifund-ops
BUYER_INTERNAL_TOKEN=dev-buyer-internal
VERIFUND_SELLER_TOKEN_SECRET=dev-verifund-seller-token-secret
VERIFUND_LINK_SECRET=dev-verifund-link-secret
VERIFUND_RECEIPT_KEYS='{"dev-1":"dev-verifund-receipt-key"}'
VERIFUND_RECEIPT_ACTIVE_KID=dev-1

# Storage
VERIFUND_DATABASE_URL=sqlite+aiosqlite:///./data/verifund.db
VERIFUND_EVIDENCE_DIR=./data/evidence
VERIFUND_MAX_EVIDENCE_BYTES=25000000

# Lifecycle
VERIFUND_TIMEOUT_SECONDS=20
VERIFUND_SELLER_TOKEN_TTL_HOURS=72
VERIFUND_CHECKOUT_LINK_TTL_MINUTES=30
VERIFUND_RETURN_LINK_TTL_HOURS=24
VERIFUND_EVIDENCE_DEADLINE_HOURS=72
VERIFUND_INSPECTION_WINDOW_HOURS=24
VERIFUND_FUNDING_TIMEOUT_HOURS=24
VERIFUND_PAYOUT_ALERT_HOURS=1
VERIFUND_AUTO_EVIDENCE=true
VERIFUND_EVIDENCE_RETRY_SECONDS=2
# Seller workspace Clerk access + settlement internal auth.
# Shared by the control plane and the seller agent. Must match on both sides.
# In local dev (`make dev`) scripts/config.py provisions this dynamically
# from SELLER_INTERNAL_TOKEN when the explicit var is unset.
# VERIFUND_SETTLEMENT_INTERNAL_TOKEN=
# Seller agent single-tenant context for internal settlement calls.
SELLER_ORGANIZATION_ID=
# Buyer workspace Clerk access (direct clerk_user_id -> buyer_profile).
# Shared by the control plane and the buyer agent. Must match on both sides.
VERIFUND_BUYER_SETTLEMENT_INTERNAL_TOKEN=
BUYER_CLERK_USER_ID=user_buyer

# PayPal Sandbox. See docs/verifund-paypal-sandbox.md.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLATFORM_EMAIL=
PAYPAL_BUYER_EMAIL=
VERIFUND_SELLER_PAYOUT_EMAILS='{"northwind-audio":"seller-northwind@example.com","circuitforge":"seller-circuitforge@example.com","aurora-supply":"seller-aurora@example.com","summit-tech":"seller-summit@example.com"}'

# Embedded checkout. redirect keeps the PayPal-hosted checkout link; embedded
# renders the PayPal button inside the console chat (sandbox deployments only).
# NEXT_PUBLIC_PAYPAL_CLIENT_ID must equal PAYPAL_CLIENT_ID; PAYPAL_CLIENT_SECRET
# stays server-side and is never exposed to the browser.
VERIFUND_CHECKOUT_MODE=redirect
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=sandbox

# Reconciler
VERIFUND_RECONCILER_ENABLED=true
VERIFUND_RECONCILER_PENDING_SECONDS=30
VERIFUND_RECONCILER_DEADLINE_SECONDS=60
VERIFUND_RECONCILER_RECEIPT_SECONDS=300

# Fake mode only
VERIFUND_FAKE_SCENARIO=success
VERIFUND_FAKE_WEBHOOK_SECRET=dev-verifund-fake-webhook

CPK_INTELLIGENCE_API_KEY=
INTELLIGENCE_API_URL=
INTELLIGENCE_GATEWAY_WS_URL=
ORCHESTRATOR_SESSION_DB_URL=sqlite+aiosqlite:///./data/orchestrator_sessions.db
